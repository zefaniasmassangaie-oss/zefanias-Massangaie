      "args": ["run", "test:auth"],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Format mobile data service",
      "type": "shell",
      "command": "npx",
      "args": [
        "oxfmt",
        ".vscode/tasks.json",
        "src/pages/BooksPage.vue",
        "src/pages/ReadersPage.vue",
        "src/pages/UsersPage.vue",
        "src/services/api.js",
        "src/services/auth.js",
        "src/services/nativeApi.js"
      ],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Validate project lint",
      "type": "shell",
      "command": "npm",
      "args": ["run", "lint:check"],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Validate web authentication CRUD",
      "type": "shell",
      "command": "npm",
