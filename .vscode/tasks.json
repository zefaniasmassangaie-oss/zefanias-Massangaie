{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Install Capacitor SQLite dependencies",
      "type": "shell",
      "command": "npm",
      "args": [
        "install",
        "@capacitor/core@^8",
        "@capacitor-community/sqlite@^8",
        "scrypt-js"
      ],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Install Capacitor SQLite mobile dependencies",
      "type": "shell",
      "command": "npm",
      "args": [
        "install",
        "@capacitor/core@^8",
        "@capacitor-community/sqlite@^8",
        "scrypt-js"
      ],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Install SQLite plugin in Capacitor project",
      "type": "shell",
      "command": "npm",
      "args": ["install", "--prefix", "src-capacitor"],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Build Capacitor Android assets",
      "type": "shell",
      "command": "npm",
      "args": ["run", "android:assets"],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Check project lint",
      "type": "shell",
      "command": "npm",
      "args": ["run", "lint:check"],
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Run auth and CRUD tests",
